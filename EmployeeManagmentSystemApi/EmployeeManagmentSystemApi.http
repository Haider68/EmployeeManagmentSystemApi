@EmployeeManagmentSystemApi_HostAddress = http://localhost:5168
@AdminToken = YOUR_ADMIN_JWT_HERE

GET {{EmployeeManagmentSystemApi_HostAddress}}/weatherforecast/
Accept: application/json

###

# Admin login (copy accessToken from response into @AdminToken for chat tests)
# POST {{EmployeeManagmentSystemApi_HostAddress}}/api/v1/admin/login
# Content-Type: application/json
#
# {
#   "email": "admin@example.com",
#   "password": "your-password"
# }

POST {{EmployeeManagmentSystemApi_HostAddress}}/api/v1/chat/message
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "message": "Get today's absent employees",
  "history": []
}

